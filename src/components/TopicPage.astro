---
import Base from '../layouts/Base.astro';
import { SITE, RATING, SOURCES } from '../lib/site';
import { GROUP_LABELS, type Topic, relatedTopics } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const { content } = topic;
const group = topic.group;
const groupInfo = GROUP_LABELS[group];
const siteUrl = SITE.url;
const attractionId = `${siteUrl}/#attraction`;
const pageUrl = `${siteUrl}/${topic.slug}/`;
const hubUrl = `${siteUrl}/${group}/`;
const related = relatedTopics(topic.slug);

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  url: pageUrl,
  name: content.h1,
  description: content.metaDescription,
  inLanguage: 'es-PE',
  about: { '@type': 'TouristAttraction', '@id': attractionId },
  dateModified: '2026-11-01',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { position: 1, name: 'Inicio', item: `${siteUrl}/` },
    { position: 2, name: groupInfo.label, item: hubUrl },
    { position: 3, name: content.h1, item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title={content.metaTitle}
  description={content.metaDescription}
  image="/images/plaza-sargento-lores.svg"
  imageAlt="Ilustración conceptual de palmeras y un paseo; no representa la plaza real"
>
<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<header style="position:fixed;z-index:4;top:0;left:0;right:0;background:#10281cf4;color:white"><div class="container nav">
  <a class="brand" href="/"><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#f2c35f"/><path d="M16 43c7-17 13-26 16-26s9 9 16 26" fill="none" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/><path d="M21 38h22" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/></svg><span>Plaza Sargento</span></a>
  <a class="btn btn-light" href="/">Volver a la guía</a>
</div></header>

<main class="section" style="padding-top:120px;background:#e8f0e9">
  <div class="container" style="max-width:920px">
    <nav class="breadcrumb" aria-label="Ruta de navegación" style="color:#3d5a48;margin-bottom:18px">
      <a href="/">Inicio</a> <span aria-hidden="true">→</span>
      <a href={hubUrl}>{groupInfo.label}</a> <span aria-hidden="true">→</span>
      <span>{content.h1}</span>
    </nav>
    <div class="eyebrow">Plaza Sargento Lores · Iquitos</div>
    <h1 style="font-family:Georgia,serif;font-size:clamp(2.2rem,5vw,3.6rem);line-height:1.05;margin:.3rem 0 1rem">{content.h1}</h1>
    <p class="lead">{content.lead}</p>
    <div class="badge-row" style="display:flex;gap:10px;flex-wrap:wrap;margin:18px 0">
      <span class="badge" style="border:1px solid #173f2c33;background:#ffffffcc;padding:8px 12px;border-radius:999px;font-size:.9rem">★ {RATING.value.toFixed(1)} / 5 · {RATING.count.toLocaleString('es-PE')} opiniones · Google Maps, {RATING.asOf}</span>
      <span class="badge" style="border:1px solid #173f2c33;background:#ffffffcc;padding:8px 12px;border-radius:999px;font-size:.9rem">Actualizado: {content.updated}</span>
    </div>

    {content.sections.map((sec) => (
      <section class="section" style="padding:34px 0;background:transparent">
        <h2 style="font-family:Georgia,serif;font-size:clamp(1.6rem,3vw,2.4rem);line-height:1.1;margin:.2rem 0 .8rem">{sec.heading}</h2>
        {sec.paragraphs?.map((p) => <p style="color:#33473c;line-height:1.75">{p}</p>)}
        {sec.bullets && (
          <ul style="padding-left:20px;color:#33473c;line-height:1.8">
            {sec.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
        {sec.callout && (
          <div class="notice" style="padding:16px;border-left:4px solid var(--sun);background:#fff8dc;border-radius:10px;margin-top:14px;color:#3d3320">
            <strong>Nota:</strong> {sec.callout}
          </div>
        )}
      </section>
    ))}

    <section class="section faq" style="padding:34px 0;background:transparent">
      <div class="eyebrow">Preguntas frecuentes</div>
      <h2 style="font-family:Georgia,serif;font-size:clamp(1.6rem,3vw,2.4rem);margin:.2rem 0 1rem">Preguntas frecuentes</h2>
      {content.faq.map((f) => (
        <details style="border-top:1px solid #173f2c22;padding:16px 0">
          <summary style="font-weight:800;cursor:pointer">{f.q}</summary>
          <p style="color:#3d5a48">{f.a}</p>
        </details>
      ))}
    </section>

    <section class="section" style="padding:34px 0;background:#fffdf8;border-radius:20px">
      <h2 style="font-family:Georgia,serif;font-size:1.5rem;margin:.2rem 0 .8rem">Guías relacionadas</h2>
      <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px">
        {related.map((t) => (
          <a href={`/${t.slug}/`} style="display:block;padding:16px;border:1px solid #183d2a22;border-radius:14px;text-decoration:none;color:#16271e;background:#fff">
            <strong>{t.content.h1}</strong>
            <p style="font-size:.86rem;color:#5c6b62;margin:.4rem 0 0">{t.content.lead}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section" style="padding:34px 0;background:transparent">
      <h2 style="font-family:Georgia,serif;font-size:1.5rem;margin:.2rem 0 .8rem">Fuentes y metodología</h2>
      <p style="color:#33473c">La dirección y valoración proceden de la ficha de Maps. La municipalidad aporta el contexto cívico; el Ejército, la biografía de Fernando Lores Tenazoa; el Ministerio de Cultura, la información de museos. Confirma horarios y condiciones directamente con cada fuente.</p>
      <div class="card" style="background:#fffdf8;border:1px solid #183d2a18;border-radius:20px;padding:20px;margin-top:14px">
        <ul style="padding-left:18px;color:#3d5a48;line-height:1.9">
          {SOURCES.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a></li>)}
        </ul>
      </div>
      <p class="fine" style="font-size:.82rem;color:#52645a;margin-top:14px">Este sitio es una guía independiente de visitantes y no está afiliada a ninguna entidad gubernamental u organización oficial. La valoración {RATING.value.toFixed(1)}/5 y {RATING.count.toLocaleString('es-PE')} opiniones proceden de Google Maps, consultado {RATING.asOfFull}; son datos de terceros que pueden cambiar.</p>
    </section>
  </div>
</main>
<footer style="background:#10281c;color:#e7eee8;padding:64px 0 28px">
  <div class="container" style="max-width:920px">
    <div class="footer-grid" style="display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:38px">
      <div>
        <a class="brand" href="/" style="display:flex;gap:11px;align-items:center;font-weight:900;text-decoration:none;color:#fff"><svg viewBox="0 0 64 64" aria-hidden="true" style="width:42px;height:42px"><circle cx="32" cy="32" r="29" fill="#f2c35f"/><path d="M16 43c7-17 13-26 16-26s9 9 16 26" fill="none" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/><path d="M21 38h22" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/></svg><span>Plaza Sargento</span></a>
        <p class="fine" style="color:#b9c9bf">Guía independiente para comprender y visitar la Plaza Sargento Lores de Iquitos.</p>
      </div>
      <div><strong>Información</strong><p style="line-height:2"><a href="/historia/" style="color:#f1f4ef">Historia</a><br><a href="/visita/" style="color:#f1f4ef">Cómo visitar</a><br><a href={hubUrl} style="color:#f1f4ef">{groupInfo.label}</a><br><a href="/rutas/" style="color:#f1f4ef">Rutas</a></p></div>
      <div><strong>Legal</strong><p style="line-height:2"><a href="/privacidad/" style="color:#f1f4ef">Privacidad</a><br><a href="/terminos/" style="color:#f1f4ef">Términos</a><br><a href="/cookies/" style="color:#f1f4ef">Cookies</a></p></div>
    </div>
    <hr style="border:0;border-top:1px solid #ffffff22;margin:38px 0 24px" />
    <div class="fine" style="color:#b9c9bf">
      <p>Este sitio web es un proyecto independiente de información para visitantes y no está afiliado a ninguna entidad gubernamental u organización oficial.</p>
      <p>La información se contrasta con materiales públicos de la Municipalidad Provincial de Maynas, el Gobierno Regional de Loreto y las instituciones nacionales de turismo del Perú. Confirma directamente los horarios y las condiciones del servicio que necesites.</p>
      <p>Las imágenes son ilustraciones conceptuales de esta guía, no fotografías documentales.</p>
      <p>© 2026 Guía Plaza Sargento Lores. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
</Base>
