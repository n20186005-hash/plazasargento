---
import { TOPICS, GROUP_LABELS, type TopicGroup } from '../data/topics';

// Clúster de guías temáticas para la página de inicio.
const groups: TopicGroup[] = ['historia', 'visita', 'alrededores', 'comer', 'rutas'];
---
<section class="section topic-links" style="background:#f3f8f2">
  <div class="container" style="max-width:1100px">
    <div class="eyebrow">Guías temáticas</div>
    <h2 style="font-family:Georgia,serif;font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.05;margin:.3rem 0 1rem">
      Explora Iquitos desde la plaza
    </h2>
    <p style="color:#3d5a48;max-width:640px">Más de 40 guías prácticas sobre historia, cómo visitar, alrededores, dónde comer y rutas por el centro de Iquitos.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:28px">
      {groups.map((g) => (
        <div class="card" style="background:#fff;border:1px solid #183d2a18;border-radius:18px;padding:22px">
          <a href={`/${g}/`} style="text-decoration:none;color:#16271e">
            <h3 style="font-family:Georgia,serif;font-size:1.35rem;margin:0 0 .4rem">{GROUP_LABELS[g].label}</h3>
          </a>
          <p style="color:#5c6b62;font-size:.92rem;margin:0 0 14px;min-height:42px">{GROUP_LABELS[g].description}</p>
          <ul style="padding-left:16px;margin:0;color:#33473c;line-height:1.9;font-size:.92rem">
            {TOPICS.filter((t) => t.group === g).slice(0, 6).map((t) => (
              <li><a href={`/${t.slug}/`} style="color:#1f352a">{t.content.h1}</a></li>
            ))}
          </ul>
          <a href={`/${g}/`} style="display:inline-block;margin-top:14px;color:#0a6b3f;font-weight:700">Ver todas →</a>
        </div>
      ))}
    </div>

    <p style="text-align:center;margin-top:18px"><a href="/historia/" style="color:#0a6b3f;font-weight:700">Ver el índice completo de guías →</a></p>
  </div>
</section>
