---
import Base from './Base.astro';
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
<header style="position:fixed;background:#10281cf4"><div class="container nav">
<a class="brand" href="/"><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#f2c35f"/><path d="M16 43c7-17 13-26 16-26s9 9 16 26" fill="none" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/><path d="M21 38h22" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/></svg><span>Plaza Sargento</span></a>
<a class="btn btn-light" href="/">Volver a la guía</a></div></header>
<main class="policy section"><div class="container" style="max-width:850px"><slot /></div></main>
</Base>
