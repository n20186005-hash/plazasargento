  <a class="brand" href="#inicio" aria-label="Plaza Sargento - Inicio"><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#f2c35f"/><path d="M16 43c7-17 13-26 16-26s9 9 16 26" fill="none" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/><path d="M21 38h22" stroke="#173f2c" stroke-width="5" stroke-linecap="round"/></svg><span>Plaza Sargento</span></a>
  <nav class="navlinks" aria-label="Navegación principal"><a href="#historia">Historia</a><a href="#visita">Visita</a><a href="#llegar">Cómo llegar</a><a href="#clima">Clima</a><a href="#servicios">Servicios</a><a href="#temporada">Temporada</a><a href="#itinerarios">Rutas</a><a href="#mapa">Mapa</a><a href="#faq">Preguntas</a></nav>
<details class="mobile-nav"><summary>Menú</summary><nav aria-label="Navegación móvil"><a href="#historia">Historia</a><a href="#visita">Visita</a><a href="#llegar">Cómo llegar</a><a href="#clima">Clima</a><a href="#servicios">Servicios</a><a href="#temporada">Temporada</a><a href="#itinerarios">Rutas</a><a href="#mapa">Mapa</a><a href="#faq">Preguntas</a></nav></details>
